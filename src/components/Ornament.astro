---
/**
 * Elemen dekoratif: pola geometris islami & pembatas section non-lurus.
 * Semua murni SVG/CSS — nol JS, tidak menambah request.
 */
interface Props {
  type: 'pattern' | 'wave-top' | 'wave-bottom' | 'angle-bottom' | 'arch' | 'star-grid' | 'blob';
  class?: string;
  /** khusus tipe pattern & star-grid */
  opacity?: number;
}
const { type, class: className = '', opacity = 0.06 } = Astro.props as Props;
const uid = Math.random().toString(36).slice(2, 8);
---

{
  type === 'pattern' && (
    <svg
      class={`pointer-events-none absolute inset-0 h-full w-full ${className}`}
      aria-hidden="true"
      style={`opacity:${opacity}`}
    >
      <defs>
        <pattern id={`pt-${uid}`} width="72" height="72" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <g fill="none" stroke="currentColor" stroke-width="1.4">
            <rect x="14" y="14" width="44" height="44" />
            <rect x="14" y="14" width="44" height="44" transform="rotate(45 36 36)" />
            <circle cx="36" cy="36" r="7" />
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#pt-${uid})`} />
    </svg>
  )
}

{
  type === 'star-grid' && (
    <svg
      class={`pointer-events-none absolute inset-0 h-full w-full ${className}`}
      aria-hidden="true"
      style={`opacity:${opacity}`}
    >
      <defs>
        <pattern id={`sg-${uid}`} width="56" height="56" patternUnits="userSpaceOnUse">
          <path
            d="M28 8l4.6 11.4L44 24l-11.4 4.6L28 40l-4.6-11.4L12 24l11.4-4.6z"
            fill="currentColor"
          />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#sg-${uid})`} />
    </svg>
  )
}

{
  type === 'wave-top' && (
    <svg
      class={`pointer-events-none absolute inset-x-0 top-0 w-full ${className}`}
      viewBox="0 0 1440 90"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {/* Isi menempel tepi ATAS, gelombang menjorok ke bawah */}
      <path
        d="M0 50c180-30 360-40 540-20 210 24 420 50 630 30 96-9 192-25 270-40V0H0Z"
        fill="currentColor"
      />
    </svg>
  )
}

{
  type === 'wave-bottom' && (
    <svg
      class={`pointer-events-none absolute inset-x-0 bottom-0 w-full ${className}`}
      viewBox="0 0 1440 90"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {/* Isi menempel tepi BAWAH, gelombang menjorok ke atas */}
      <path
        d="M0 40c180 30 360 40 540 20 210-24 420-50 630-30 96 9 192 25 270 40v20H0Z"
        fill="currentColor"
      />
    </svg>
  )
}

{
  type === 'angle-bottom' && (
    <svg
      class={`pointer-events-none absolute inset-x-0 bottom-0 w-full ${className}`}
      viewBox="0 0 1440 72"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M0 72 1440 0v72z" fill="currentColor" />
    </svg>
  )
}

{
  type === 'arch' && (
    <svg class={`pointer-events-none ${className}`} viewBox="0 0 200 260" aria-hidden="true">
      <path
        d="M100 4c53 0 96 43 96 96v156H4V100C4 47 47 4 100 4Z"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <path
        d="M100 30c39 0 70 31 70 70v130H30V100c0-39 31-70 70-70Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        opacity="0.5"
      />
    </svg>
  )
}

{
  type === 'blob' && (
    <svg class={`pointer-events-none ${className}`} viewBox="0 0 200 200" aria-hidden="true">
      <path
        fill="currentColor"
        d="M45.6 -58.4C58.1 -49.6 66.2 -34.2 70.6 -17.6C75 -1 75.7 16.9 68.4 30.6C61.1 44.3 45.8 53.9 30.2 60.4C14.6 66.9 -1.4 70.3 -18.2 67.6C-35 64.9 -52.6 56.1 -62.4 42C-72.2 27.9 -74.2 8.5 -70.4 -9C-66.6 -26.5 -57 -42.1 -43.7 -51C-30.4 -59.9 -13.4 -62.1 2.4 -65C18.2 -67.9 33.1 -67.2 45.6 -58.4Z"
        transform="translate(100 100)"
      />
    </svg>
  )
}
