---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { nav, contact, waLink, defaultWaMessage } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  if (href === "/") return path === "/";
  const clean = href.split("#")[0].replace(/\/$/, "");
  return clean !== "" && path.startsWith(clean);
};
const wa = waLink(contact.mainWhatsApp.number, defaultWaMessage);
---

<header
  id="site-nav"
  data-nav
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,backdrop-filter] duration-500 ease-out-expo"
>
  <!-- Bar informasi tipis -->
  <div
    data-nav-topbar
    class="hidden overflow-hidden border-b border-white/10 bg-primary-800 text-white/80 transition-all duration-500 ease-out-expo lg:block"
  >
    <div
      class="container flex h-9 items-center justify-between text-[0.78rem] font-medium"
    >
      <p class="flex items-center gap-2">
        <Icon name="sparkles" size={14} class="text-gold-300" />
        SPMB Tahun Ajaran 2027/2028 telah dibuka — kuota terbatas
      </p>
      <div class="flex items-center gap-5">
        <a
          href={`mailto:${contact.email}`}
          class="flex items-center gap-1.5 transition-colors hover:text-gold-300"
        >
          <Icon name="mail" size={14} />{contact.email}
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 transition-colors hover:text-gold-300"
        >
          <Icon name="whatsapp" size={14} />{contact.mainWhatsApp.label}
        </a>
      </div>
    </div>
  </div>

  <nav
    class="container flex h-[4.5rem] items-center justify-between gap-4"
    aria-label="Navigasi utama"
  >
    <a
      href="/"
      class="shrink-0 rounded-lg"
      aria-label="Beranda Yayasan Panatagama"
    >
      <span data-nav-logo-dark class="hidden"><Logo variant="dark" /></span>
      <span data-nav-logo-light><Logo variant="light" /></span>
    </a>

    <!-- Navigasi desktop -->
    <ul class="hidden items-center gap-1 lg:flex" data-nav-links>
      {
        nav.map((item) =>
          item.children ? (
            <li class="group relative">
              <a
                href={item.href}
                class="flex items-center gap-1 rounded-full px-4 py-2 text-[0.9rem] font-semibold transition-colors duration-300"
                aria-haspopup="true"
              >
                {item.label}
                <Icon
                  name="chevron-down"
                  size={15}
                  class="transition-transform duration-300 group-hover:rotate-180"
                />
              </a>
              <div class="invisible absolute left-1/2 top-full w-[19rem] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-300 ease-out-expo group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <div class="overflow-hidden rounded-2xl border border-sand-200 bg-white p-2 shadow-lift">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="group/i flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors duration-200 hover:bg-primary-50"
                    >
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-primary-600 transition-colors duration-200 group-hover/i:bg-primary-600 group-hover/i:text-white">
                        <Icon name="graduation-cap" size={17} />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.875rem] font-bold text-primary-800">
                          {child.label}
                        </span>
                        <span class="block text-xs text-ink-muted">
                          {child.desc}
                        </span>
                      </span>
                      <Icon
                        name="arrow-right"
                        size={15}
                        class="ml-auto shrink-0 -translate-x-1 text-primary-400 opacity-0 transition-all duration-200 group-hover/i:translate-x-0 group-hover/i:opacity-100"
                      />
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "relative rounded-full px-4 py-2 text-[0.9rem] font-semibold transition-colors duration-300",
                  isActive(item.href) && "is-current",
                ]}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="hidden items-center gap-2.5 lg:flex">
      <Button
        href={wa}
        variant="outline"
        size="sm"
        icon="whatsapp"
        iconPosition="left"
        external>Tanya Admin</Button
      >
      <Button href="/ppdb" variant="secondary" size="sm" icon="arrow-right"
        >Daftar Sekarang</Button
      >
    </div>

    <!-- Tombol hamburger -->
    <button
      type="button"
      data-nav-toggle
      class="relative z-50 flex h-11 w-11 items-center justify-center rounded-full border transition-colors duration-300 lg:hidden"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Menu</span>
      <span class="flex w-5 flex-col items-end gap-[5px]" aria-hidden="true">
        <span
          data-bar
          class="h-[2px] w-5 origin-center rounded-full bg-current transition-all duration-300 ease-out-expo"
        ></span>
        <span
          data-bar
          class="h-[2px] w-3.5 rounded-full bg-current transition-all duration-300 ease-out-expo"
        ></span>
        <span
          data-bar
          class="h-[2px] w-5 origin-center rounded-full bg-current transition-all duration-300 ease-out-expo"
        ></span>
      </span>
    </button>
  </nav>
</header>

<!-- Panel navigasi mobile -->
<div
  id="mobile-menu"
  data-nav-panel
  class="pointer-events-none fixed inset-0 z-40 opacity-0 transition-opacity duration-300 lg:hidden"
>
  <div
    data-nav-scrim
    class="absolute inset-0 bg-primary-950/50 backdrop-blur-sm"
  >
  </div>
  <div
    data-nav-sheet
    class="absolute inset-y-0 right-0 flex w-full max-w-sm translate-x-full flex-col overflow-y-auto bg-sand-50 pb-8 pt-24 shadow-lift transition-transform duration-500 ease-out-expo"
  >
    <nav class="flex-1 px-6" aria-label="Navigasi mobile">
      <ul class="space-y-1">
        {
          nav.map((item, i) => (
            <li data-nav-item style={`--i:${i}`}>
              <a
                href={item.href}
                class:list={[
                  "flex items-center justify-between rounded-2xl px-4 py-3.5 text-lg font-bold text-primary-800 transition-colors duration-200 hover:bg-white",
                  isActive(item.href) &&
                    "bg-white text-secondary-600 shadow-soft",
                ]}
              >
                {item.label}
                <Icon name="chevron-right" size={18} class="text-primary-300" />
              </a>
              {item.children && (
                <ul class="mb-2 ml-4 space-y-0.5 border-l-2 border-sand-200 pl-3">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="flex flex-col rounded-xl px-3 py-2 transition-colors duration-200 hover:bg-white"
                      >
                        <span class="text-[0.95rem] font-semibold text-ink">
                          {child.label}
                        </span>
                        <span class="text-xs text-ink-muted">{child.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-6 space-y-3 px-6">
      <Button
        href="/ppdb"
        variant="secondary"
        size="md"
        icon="arrow-right"
        fullWidth>Daftar Sekarang</Button
      >
      <Button
        href={wa}
        variant="outline"
        size="md"
        icon="whatsapp"
        iconPosition="left"
        external
        fullWidth>Tanya via WhatsApp</Button
      >
      <p class="pt-2 text-center text-xs text-ink-muted">
        {contact.officeHours}
      </p>
    </div>
  </div>
</div>

<style>
  /* Status default: navbar transparan di atas hero gelap */
  [data-nav] :global([data-nav-links] a) {
    color: rgb(255 255 255 / 0.85);
  }
  [data-nav] :global([data-nav-links] a:hover),
  [data-nav] :global([data-nav-links] a.is-current) {
    color: #fff;
  }
  [data-nav] [data-nav-toggle] {
    color: #fff;
    border-color: rgb(255 255 255 / 0.3);
  }

  /* Status setelah scroll: navbar solid */
  [data-nav].is-stuck {
    background-color: rgb(252 251 248 / 0.88);
    backdrop-filter: saturate(180%) blur(14px);
    box-shadow:
      0 1px 0 0 rgb(6 38 26 / 0.06),
      0 2px 6px -2px rgb(6 38 26 / 0.04),
      0 8px 18px -6px rgb(6 38 26 / 0.05),
      0 18px 34px -12px rgb(6 38 26 / 0.06);
  }
  [data-nav].is-stuck [data-nav-topbar] {
    height: 0;
    opacity: 0;
    border-color: transparent;
  }
  [data-nav].is-stuck :global([data-nav-links] a) {
    color: #3d5148;
  }
  [data-nav].is-stuck :global([data-nav-links] a:hover) {
    color: #0a593a;
  }
  [data-nav].is-stuck :global([data-nav-links] a.is-current) {
    color: #ea5b23;
  }
  [data-nav].is-stuck [data-nav-toggle] {
    color: #0a593a;
    border-color: rgb(10 89 58 / 0.18);
  }

  /* Garis aktif */
  :global([data-nav-links] a.is-current)::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: #ea5b23;
  }

  /* Panel mobile terbuka */
  [data-nav-panel].is-open {
    pointer-events: auto;
    opacity: 1;
  }
  [data-nav-panel].is-open [data-nav-sheet] {
    transform: translateX(0);
  }
  [data-nav-panel] [data-nav-item] {
    opacity: 0;
    transform: translateX(18px);
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 55ms + 120ms);
  }
  [data-nav-panel].is-open [data-nav-item] {
    opacity: 1;
    transform: none;
  }

  /* Ikon hamburger → silang */
  [data-nav-toggle][aria-expanded="true"] [data-bar]:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  [data-nav-toggle][aria-expanded="true"] [data-bar]:nth-child(2) {
    opacity: 0;
    transform: translateX(10px);
  }
  [data-nav-toggle][aria-expanded="true"] [data-bar]:nth-child(3) {
    width: 1.25rem;
    transform: translateY(-7px) rotate(-45deg);
  }
  [data-nav-toggle][aria-expanded="true"] {
    color: #0a593a !important;
    border-color: rgb(10 89 58 / 0.18) !important;
  }
</style>

<script>
  const q = <T extends HTMLElement>(sel: string) =>
    document.querySelector<T>(sel);

  /** Sinkronkan tampilan navbar dengan posisi scroll saat ini */
  function syncNav() {
    const header = q("[data-nav]");
    if (!header) return;
    const stuck = window.scrollY > 24;
    header.classList.toggle("is-stuck", stuck);
    q("[data-nav-logo-dark]")?.classList.toggle("hidden", !stuck);
    q("[data-nav-logo-light]")?.classList.toggle("hidden", stuck);
  }

  function setOpen(open: boolean) {
    const panel = q("[data-nav-panel]");
    const toggle = q<HTMLButtonElement>("[data-nav-toggle]");
    if (!panel || !toggle) return;
    panel.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      open ? "Tutup menu navigasi" : "Buka menu navigasi",
    );
    document.documentElement.style.overflow = open ? "hidden" : "";
  }

  // Listener tingkat window/document cukup dipasang sekali per pemuatan penuh
  let globalsBound = false;

  function initNav() {
    const toggle = q<HTMLButtonElement>("[data-nav-toggle]");
    const panel = q("[data-nav-panel]");
    if (!toggle || !panel) return;

    // `astro:page-load` juga menyala pada pemuatan awal — cegah listener ganda,
    // karena dua listener pada tombol yang sama akan saling membatalkan.
    if (toggle.dataset.bound === "1") return;
    toggle.dataset.bound = "1";

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    q("[data-nav-scrim]")?.addEventListener("click", () => setOpen(false));
    panel
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", () => setOpen(false)));

    syncNav();

    if (globalsBound) return;
    globalsBound = true;

    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          syncNav();
          ticking = false;
        });
      },
      { passive: true },
    );

    document.addEventListener("keydown", (e) => {
      const t = q<HTMLButtonElement>("[data-nav-toggle]");
      if (e.key === "Escape" && t?.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        t.focus();
      }
    });

    // Tutup panel bila layar dilebarkan ke desktop
    window
      .matchMedia("(min-width: 1024px)")
      .addEventListener("change", (e) => e.matches && setOpen(false));
  }

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
