---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-yayasan-mark.png';

/**
 * Lambang resmi Yayasan Panatagama.
 *
 * Yang dipakai adalah lambangnya saja (tanpa wordmark bawaan) lalu dipasangkan
 * dengan teks yang diset ulang — wordmark di dalam berkas PNG jadi terlalu kecil
 * untuk terbaca pada tinggi navbar. Pada latar gelap lambang diberi plat putih,
 * karena bagian hijau tuanya tenggelam bila ditempel langsung.
 */
interface Props {
  /** 'light' = dipakai di atas latar gelap, 'dark' = di atas latar terang */
  variant?: 'dark' | 'light';
  class?: string;
  showText?: boolean;
  size?: 'sm' | 'md' | 'lg';
}
const { variant = 'dark', class: className = '', showText = true, size = 'md' } = Astro.props as Props;

const onDark = variant === 'light';

const markSize = {
  sm: 'h-8',
  md: 'h-9 md:h-10',
  lg: 'h-12 md:h-14',
}[size];

const titleSize = {
  sm: 'text-[0.85rem]',
  md: 'text-[0.95rem] md:text-base',
  lg: 'text-lg md:text-xl',
}[size];
---

<span class={`flex items-center gap-2.5 ${className}`}>
  <span
    class:list={[
      'flex shrink-0 items-center justify-center transition-transform duration-500 ease-out-expo',
      onDark && 'rounded-xl bg-white p-1.5 shadow-soft',
    ]}
  >
    <Image
      src={logoMark}
      alt="Lambang Yayasan Panatagama"
      widths={[80, 160, 240]}
      sizes="80px"
      class={`${markSize} w-auto`}
      loading="eager"
    />
  </span>

  {
    showText && (
      <span class="flex flex-col leading-none">
        <span
          class:list={[
            'text-[0.6rem] font-bold uppercase tracking-[0.22em]',
            onDark ? 'text-gold-300' : 'text-secondary-600',
          ]}
        >
          Yayasan
        </span>
        <span
          class:list={[
            'mt-1 font-extrabold tracking-tight',
            titleSize,
            onDark ? 'text-white' : 'text-primary-800',
          ]}
        >
          Panatagama
        </span>
      </span>
    )
  }
</span>
