---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { img } from "../lib/images";
import type { Unit } from "../data/units";

interface Props {
  unit: Unit;
  featured?: boolean;
  class?: string;
}
const { unit, featured = false, class: className = "" } = Astro.props as Props;

const href = unit.slug === "panatamart" ? "/panatamart" : `/unit/${unit.slug}`;

const accents = {
  primary: {
    chip: "bg-primary-600 text-white",
    ring: "group-hover:border-primary-300",
    dot: "bg-primary-500",
  },
  secondary: {
    chip: "bg-secondary-600 text-white",
    ring: "group-hover:border-secondary-300",
    dot: "bg-secondary-500",
  },
  gold: {
    chip: "bg-gold-400 text-primary-900",
    ring: "group-hover:border-gold-300",
    dot: "bg-gold-400",
  },
};
const a = accents[unit.accent];
---

<a
  href={href}
  class={`card card-hover group flex ${featured ? "md:col-span-2 md:flex-row" : "flex-col"} ${a.ring} ${className}`}
>
  <div class={`relative overflow-hidden ${featured ? "md:w-1/2" : ""}`}>
    <Image
      src={img(unit.cover)}
      alt={`Suasana ${unit.fullName}`}
      widths={[400, 700, 1000]}
      sizes={featured
        ? "(max-width: 768px) 100vw, 45vw"
        : "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 30vw"}
      class={`w-full object-cover transition-transform duration-[900ms] ease-out-expo group-hover:scale-[1.06] ${featured ? "h-56 md:h-full" : "h-52"}`}
      loading="lazy"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-primary-950/60 via-primary-950/5 to-transparent"
    >
    </div>
    <span
      class={`absolute left-4 top-4 rounded-full px-3 py-1.5 text-[0.7rem] font-extrabold uppercase tracking-wider ${a.chip}`}
    >
      {unit.code}
    </span>
  </div>

  <div
    class={`flex flex-1 flex-col p-6 md:p-7 ${featured ? "md:w-1/2 md:justify-center" : ""}`}
  >
    <p
      class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-ink-muted"
    >
      <span class={`h-1.5 w-1.5 rounded-full ${a.dot}`}></span>
      {unit.ageRange}
    </p>

    <h3
      class="mt-3 text-xl font-extrabold tracking-tight text-primary-800 md:text-2xl"
    >
      {unit.name}
    </h3>
    <p class="mt-1 text-[0.9rem] font-semibold text-secondary-600">
      {unit.tagline}
    </p>

    <p
      class={`mt-4 text-[0.9375rem] leading-relaxed text-ink-soft ${featured ? "" : "line-clamp-3"}`}
    >
      {unit.summary}
    </p>

    <span
      class="mt-6 inline-flex items-center gap-2 text-[0.9rem] font-bold text-primary-700 transition-colors duration-300 group-hover:text-secondary-600"
    >
      Lihat selengkapnya
      <span
        class="flex h-7 w-7 items-center justify-center rounded-full bg-primary-50 transition-all duration-300 ease-out-expo group-hover:translate-x-1 group-hover:bg-secondary-500 group-hover:text-white"
      >
        <Icon name="arrow-right" size={14} />
      </span>
    </span>
  </div>
</a>
