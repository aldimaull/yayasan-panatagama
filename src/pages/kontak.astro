---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, contact, campuses, whatsappContacts, waLink, defaultWaMessage } from '../data/site';

const socials = [
  { name: 'instagram' as const, ...contact.social.instagram, label: 'Instagram' },
  { name: 'facebook' as const, ...contact.social.facebook, label: 'Facebook' },
  { name: 'youtube' as const, ...contact.social.youtube, label: 'YouTube' },
];
---

<BaseLayout
  title="Kontak"
  description="Alamat kampus, nomor WhatsApp tiap jenjang, peta lokasi, dan formulir kontak Yayasan Panatagama di Subang, Jawa Barat."
>
  <PageHero
    eyebrow="Hubungi Kami"
    title="Mari mengobrol, kami mudah dihubungi"
    highlight="mudah dihubungi"
    desc="Pilih jalur yang paling nyaman untuk Anda: WhatsApp langsung ke admin jenjang, datang ke kampus, atau kirim pesan lewat formulir di bawah."
    image="tentang-kegiatan"
    breadcrumbs={[{ label: 'Kontak' }]}
  />

  <!-- ================================================== KONTAK CEPAT -->
  <section class="relative -mt-8 pb-4" aria-label="Kontak cepat">
    <div class="container">
      <Reveal animation="zoom">
        <div class="grid gap-px overflow-hidden rounded-3xl border border-sand-200 bg-sand-200 shadow-lift sm:grid-cols-3">
          <a
            href={waLink(contact.mainWhatsApp.number, defaultWaMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white p-6 transition-colors duration-300 hover:bg-primary-50 md:p-7"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-secondary-500 text-white transition-transform duration-300 group-hover:scale-105">
              <Icon name="whatsapp" size={20} />
            </span>
            <p class="mt-4 text-[0.75rem] font-extrabold uppercase tracking-wider text-ink-muted">
              WhatsApp Informasi
            </p>
            <p class="mt-1 text-[1.05rem] font-extrabold text-primary-800">{contact.mainWhatsApp.label}</p>
          </a>

          <a
            href={`mailto:${contact.email}`}
            class="group bg-white p-6 transition-colors duration-300 hover:bg-primary-50 md:p-7"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-600 text-white transition-transform duration-300 group-hover:scale-105">
              <Icon name="mail" size={20} />
            </span>
            <p class="mt-4 text-[0.75rem] font-extrabold uppercase tracking-wider text-ink-muted">Email</p>
            <p class="mt-1 break-all text-[1.05rem] font-extrabold text-primary-800">{contact.email}</p>
          </a>

          <div class="bg-white p-6 md:p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gold-400 text-primary-900">
              <Icon name="clock" size={20} />
            </span>
            <p class="mt-4 text-[0.75rem] font-extrabold uppercase tracking-wider text-ink-muted">
              Jam Layanan
            </p>
            <p class="mt-1 text-[1.05rem] font-extrabold text-primary-800">{contact.officeHours}</p>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ================================================ KONTAK PER UNIT -->
  <section class="section" aria-labelledby="kontak-unit">
    <div class="container">
      <SectionHeading
        eyebrow="Kontak per Jenjang"
        title="Langsung ke admin yang tepat"
        highlight="admin yang tepat"
        desc="Setiap jenjang punya admin sendiri agar pertanyaan Anda dijawab oleh orang yang memang menanganinya."
        align="center"
        maxW="max-w-2xl"
      />

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          whatsappContacts.map((w, i) => (
            <Reveal delay={(i % 4) * 80} class="h-full">
              <a
                href={waLink(w.number, `Assalamu'alaikum, saya ingin bertanya mengenai ${w.unit}.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex h-full flex-col rounded-3xl border border-sand-200 bg-white p-7 shadow-soft transition-all duration-500 ease-out-expo hover:-translate-y-1.5 hover:border-primary-200 hover:shadow-lift"
              >
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-50 text-primary-600 transition-colors duration-300 group-hover:bg-[#25D366] group-hover:text-white">
                  <Icon name="whatsapp" size={22} />
                </span>
                <h3 class="mt-6 text-lg font-extrabold tracking-tight text-primary-800">{w.unit}</h3>
                <p class="mt-1.5 flex-1 text-[0.95rem] font-semibold text-ink-soft">{w.label}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-[0.85rem] font-bold text-secondary-600">
                  Chat sekarang
                  <Icon name="arrow-up-right" size={15} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </span>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================================= KAMPUS -->
  <section class="section relative overflow-hidden bg-sand-100" aria-labelledby="kampus">
    <Ornament type="pattern" class="text-primary-600" opacity={0.03} />

    <div class="container relative">
      <SectionHeading
        eyebrow="Lokasi Kampus"
        title="Dua kampus di jantung Kota Subang"
        highlight="Kota Subang"
        desc="Keduanya mudah dijangkau dan dilalui layanan shuttle sekolah untuk beberapa rute dalam kota."
        align="center"
        maxW="max-w-2xl"
      />

      <div class="mt-14 space-y-8">
        {
          campuses.map((c, i) => (
            <Reveal delay={i * 100}>
              <div class="grid gap-8 overflow-hidden rounded-4xl border border-sand-200 bg-white p-6 shadow-soft md:p-8 lg:grid-cols-5">
                <div class={`lg:col-span-2 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
                  <span class="eyebrow text-secondary-600">Kampus {i + 1}</span>
                  <h3 class="mt-3 text-2xl font-extrabold tracking-tight text-primary-800">
                    {c.name.split('—')[1]?.trim() ?? c.name}
                  </h3>
                  <p class="mt-2 text-[0.9rem] font-semibold text-ink-muted">{c.units}</p>

                  <p class="mt-6 flex gap-3 text-[0.9375rem] leading-relaxed text-ink-soft">
                    <Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-secondary-500" />
                    {c.address}
                  </p>

                  <div class="mt-7 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
                    <Button
                      href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.mapQuery)}`}
                      variant="primary"
                      icon="arrow-up-right"
                      external
                    >
                      Buka di Maps
                    </Button>
                    <Button
                      href={waLink(contact.mainWhatsApp.number, `Assalamu'alaikum, saya ingin menjadwalkan kunjungan ke ${c.units}.`)}
                      variant="outline"
                      icon="calendar"
                      iconPosition="left"
                      external
                    >
                      Jadwalkan Kunjungan
                    </Button>
                  </div>
                </div>

                <div class={`overflow-hidden rounded-3xl border border-sand-200 lg:col-span-3 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
                  <iframe
                    src={c.mapEmbed}
                    title={`Peta lokasi ${c.name}`}
                    width="100%"
                    height="100%"
                    style="border:0;min-height:20rem"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen></iframe>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= FORMULIR -->
  <section class="section" aria-labelledby="form-kontak">
    <div class="container">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeading
            eyebrow="Kirim Pesan"
            title="Ada yang ingin ditanyakan?"
            highlight="ingin ditanyakan"
            desc="Tulis pesan Anda di sini. Formulir akan menyiapkan pesan WhatsApp ke admin kami — Anda tinggal menekan kirim."
            maxW="max-w-none"
          />

          <Reveal delay={200}>
            <div class="mt-9 rounded-3xl border border-sand-200 bg-white p-7 shadow-soft">
              <h3 class="text-[0.85rem] font-extrabold uppercase tracking-wider text-ink-muted">
                Ikuti kami
              </h3>
              <div class="mt-4 flex flex-col gap-2">
                {
                  socials.map((s) => (
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors duration-200 hover:bg-primary-50"
                    >
                      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-50 text-primary-600 transition-colors duration-200 group-hover:bg-primary-600 group-hover:text-white">
                        <Icon name={s.name} size={17} />
                      </span>
                      <span>
                        <span class="block text-[0.875rem] font-bold text-primary-800">{s.label}</span>
                        <span class="block text-xs text-ink-muted">{s.handle}</span>
                      </span>
                      <Icon name="arrow-up-right" size={15} class="ml-auto text-primary-300" />
                    </a>
                  ))
                }
              </div>
            </div>
          </Reveal>
        </div>

        <div class="lg:col-span-7">
          <Reveal animation="right">
            <form id="form-kontak" class="rounded-4xl border border-sand-200 bg-white p-7 shadow-soft md:p-10" novalidate>
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="k-nama" class="block text-[0.85rem] font-bold text-primary-800">
                    Nama Anda <span class="text-secondary-600">*</span>
                  </label>
                  <input
                    id="k-nama"
                    type="text"
                    required
                    autocomplete="name"
                    placeholder="Nama lengkap"
                    class="mt-2 w-full rounded-2xl border border-sand-200 bg-sand-50 px-5 py-3.5 text-[0.9375rem] text-ink transition-all duration-300 placeholder:text-ink-muted/60 focus:border-primary-400 focus:bg-white"
                  />
                </div>

                <div>
                  <label for="k-telepon" class="block text-[0.85rem] font-bold text-primary-800">
                    Nomor WhatsApp <span class="text-secondary-600">*</span>
                  </label>
                  <input
                    id="k-telepon"
                    type="tel"
                    required
                    autocomplete="tel"
                    inputmode="tel"
                    placeholder="08xx-xxxx-xxxx"
                    class="mt-2 w-full rounded-2xl border border-sand-200 bg-sand-50 px-5 py-3.5 text-[0.9375rem] text-ink transition-all duration-300 placeholder:text-ink-muted/60 focus:border-primary-400 focus:bg-white"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="k-topik" class="block text-[0.85rem] font-bold text-primary-800">
                    Topik pertanyaan
                  </label>
                  <select
                    id="k-topik"
                    class="mt-2 w-full rounded-2xl border border-sand-200 bg-sand-50 px-5 py-3.5 text-[0.9375rem] text-ink transition-all duration-300 focus:border-primary-400 focus:bg-white"
                  >
                    <option value="Informasi umum">Informasi umum</option>
                    <option value="Pendaftaran (SPMB)">Pendaftaran (SPMB)</option>
                    <option value="Kunjungan sekolah">Kunjungan sekolah</option>
                    <option value="Panatagama Course">Panatagama Course</option>
                    <option value="PanataMart">PanataMart</option>
                    <option value="Kerja sama / lainnya">Kerja sama / lainnya</option>
                  </select>
                </div>

                <div class="sm:col-span-2">
                  <label for="k-pesan" class="block text-[0.85rem] font-bold text-primary-800">
                    Pesan <span class="text-secondary-600">*</span>
                  </label>
                  <textarea
                    id="k-pesan"
                    rows="5"
                    required
                    placeholder="Tuliskan pertanyaan atau keperluan Anda di sini."
                    class="mt-2 w-full resize-y rounded-2xl border border-sand-200 bg-sand-50 px-5 py-3.5 text-[0.9375rem] text-ink transition-all duration-300 placeholder:text-ink-muted/60 focus:border-primary-400 focus:bg-white"
                  ></textarea>
                </div>
              </div>

              <p
                id="kontak-error"
                class="mt-5 hidden items-start gap-2 rounded-2xl border border-secondary-200 bg-secondary-50 px-4 py-3 text-[0.85rem] font-semibold text-secondary-700"
                role="alert"
              >
                <span>Mohon lengkapi kolom bertanda <span aria-hidden="true">*</span> terlebih dahulu.</span>
              </p>

              <div class="mt-7 flex flex-col gap-3 sm:flex-row">
                <Button type="submit" variant="secondary" size="lg" icon="whatsapp" iconPosition="left" class="sm:flex-1">
                  Kirim via WhatsApp
                </Button>
                <Button href={`mailto:${contact.email}`} variant="outline" size="lg" icon="mail" iconPosition="left">
                  Kirim Email
                </Button>
              </div>

              <p class="mt-5 text-[0.8rem] leading-relaxed text-ink-muted">
                Website ini tidak menyimpan data Anda. Pesan langsung diteruskan ke WhatsApp admin
                {' '}{site.shortName}.
              </p>
            </form>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Lebih enak ngobrol langsung?"
    desc="Datang ke kampus pada jam layanan, atau buat janji lebih dulu agar kami bisa menyiapkan waktu untuk menemani Anda berkeliling."
    primaryLabel="Info SPMB"
    primaryHref="/ppdb"
  />
</BaseLayout>

<script>
  function initKontak() {
    const form = document.querySelector<HTMLFormElement>('#form-kontak');
    if (!form) return;

    // `astro:page-load` juga menyala saat pemuatan awal — tanpa penjaga ini
    // handler terpasang dua kali dan WhatsApp terbuka dua tab.
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const err = form.querySelector<HTMLElement>('#kontak-error');
    const number = '6285179538448';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = (id: string) =>
        (form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`#${id}`)?.value ?? '').trim();

      const nama = val('k-nama');
      const telepon = val('k-telepon');
      const pesan = val('k-pesan');

      const missing = !nama || !telepon || !pesan;
      err?.classList.toggle('hidden', !missing);
      err?.classList.toggle('flex', missing);
      if (missing) {
        const first = [!nama && '#k-nama', !telepon && '#k-telepon', !pesan && '#k-pesan'].find(
          Boolean,
        ) as string;
        form.querySelector<HTMLElement>(first)?.focus();
        return;
      }

      const text = [
        "Assalamu'alaikum, saya ingin bertanya.",
        '',
        `Nama: ${nama}`,
        `Nomor WhatsApp: ${telepon}`,
        `Topik: ${val('k-topik')}`,
        '',
        pesan,
      ].join('\n');

      window.open(`https://wa.me/${number}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  }

  initKontak();
  document.addEventListener('astro:page-load', initKontak);
</script>
