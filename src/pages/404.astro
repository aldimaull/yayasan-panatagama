---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import Reveal from '../components/Reveal.astro';

const shortcuts = [
  { label: 'Beranda', href: '/', icon: 'arrow-right' as const },
  { label: 'Info SPMB', href: '/ppdb', icon: 'file-pen' as const },
  { label: 'Unit Sekolah', href: '/#unit', icon: 'graduation-cap' as const },
  { label: 'Kontak', href: '/kontak', icon: 'phone' as const },
];
---

<!-- Hero gelap menempel langsung ke footer yang juga gelap, jadi kedua wave dimatikan -->
<BaseLayout title="Halaman tidak ditemukan" noindex footerWave={false}>
  <section class="relative flex min-h-screen items-center overflow-hidden bg-primary-900 py-32">
    <div class="absolute inset-0 bg-primary-mesh"></div>
    <Ornament type="pattern" class="text-white" opacity={0.06} />

    <div class="container relative text-center">
      <Reveal animation="zoom">
        <p class="text-[7rem] font-extrabold leading-none tracking-tighter text-gold-300 md:text-[11rem]">
          404
        </p>
      </Reveal>

      <Reveal delay={100}>
        <h1 class="mx-auto mt-2 max-w-2xl text-display-md text-balance text-white">
          Sepertinya halaman ini sudah pindah kelas
        </h1>
      </Reveal>

      <Reveal delay={170}>
        <p class="mx-auto mt-5 max-w-lg text-lead text-white/65">
          Alamat yang Anda tuju tidak kami temukan. Mungkin tautannya sudah berubah, atau ada salah
          ketik sedikit.
        </p>
      </Reveal>

      <Reveal delay={240}>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href="/" variant="secondary" size="lg" icon="arrow-left" iconPosition="left">
            Kembali ke Beranda
          </Button>
          <Button
            href="/kontak"
            variant="outline"
            size="lg"
            icon="phone"
            iconPosition="left"
            class="!border-white/25 !bg-white/5 !text-white hover:!border-white/60 hover:!bg-white/10"
          >
            Hubungi Kami
          </Button>
        </div>
      </Reveal>

      <Reveal delay={310}>
        <div class="mx-auto mt-14 max-w-2xl">
          <p class="text-[0.8rem] font-extrabold uppercase tracking-widest text-white/60">
            Atau lanjut ke halaman lain
          </p>
          <div class="mt-5 flex flex-wrap justify-center gap-2.5">
            {
              shortcuts.map((s) => (
                <a
                  href={s.href}
                  class="group inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-[0.875rem] font-bold text-white/80 transition-all duration-300 ease-out-expo hover:-translate-y-0.5 hover:border-gold-400 hover:bg-gold-400 hover:text-primary-900"
                >
                  <Icon name={s.icon} size={15} />
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>
