---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Accordion from '../../components/Accordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import Reveal from '../../components/Reveal.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import Ornament from '../../components/Ornament.astro';
import UnitCard from '../../components/UnitCard.astro';
import { schoolUnits, units } from '../../data/units';
import { campuses, waLink } from '../../data/site';
import { testimonialsFor } from '../../data/testimonials';

export function getStaticPaths() {
  return schoolUnits.map((unit) => ({ params: { slug: unit.slug }, props: { unit } }));
}

const { unit } = Astro.props;
const campus = campuses.find((c) => c.id === unit.campusId)!;
const quotes = testimonialsFor(unit.slug as any, 3);
const others = units.filter((u) => u.slug !== unit.slug).slice(0, 3);
const galleryItems = unit.gallery.map((name, i) => ({
  name,
  caption: [`Kegiatan ${unit.name}`, 'Pembelajaran di kelas', 'Program kokurikuler', 'Ekstrakurikuler siswa'][i % 4],
}));
const waMsg = `Assalamu'alaikum, saya ingin bertanya mengenai pendaftaran ${unit.fullName}.`;
---

<BaseLayout
  title={unit.fullName}
  description={`${unit.summary} ${unit.ageRange}. Informasi kurikulum, program unggulan, fasilitas, dan pendaftaran ${unit.fullName} di Subang.`}
>
  <PageHero
    eyebrow={`${unit.code} · ${unit.ageRange}`}
    title={unit.tagline}
    image={unit.cover}
    logo={unit.logo}
    logoAlt={`Logo ${unit.fullName}`}
    desc={unit.summary}
    breadcrumbs={[{ label: 'Unit', href: '/#unit' }, { label: unit.name }]}
  >
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <Button href="/ppdb" variant="secondary" size="lg" icon="arrow-right">Daftar Sekarang</Button>
      <Button
        href={waLink(unit.wa.number, waMsg)}
        variant="outline"
        size="lg"
        icon="whatsapp"
        iconPosition="left"
        external
        class="!border-white/25 !bg-white/5 !text-white hover:!border-white/60 hover:!bg-white/10"
      >
        WhatsApp {unit.code} · {unit.wa.label}
      </Button>
    </div>
  </PageHero>

  <!-- ============================================== FAKTA SINGKAT -->
  <section class="relative -mt-8 pb-4" aria-label="Informasi singkat">
    <div class="container">
      <Reveal animation="zoom">
        <dl class="grid gap-px overflow-hidden rounded-3xl border border-sand-200 bg-sand-200 shadow-lift sm:grid-cols-3">
          <div class="bg-white p-6 md:p-7">
            <dt class="flex items-center gap-2 text-[0.75rem] font-extrabold uppercase tracking-wider text-ink-muted">
              <Icon name="clock" size={15} class="text-secondary-500" />Jam Belajar
            </dt>
            <dd class="mt-3 space-y-1.5">
              {
                unit.schedule.map((s) => (
                  <p class="text-[0.875rem] leading-snug text-ink-soft">
                    <span class="font-bold text-primary-800">{s.label}</span>
                    <br />
                    {s.time}
                  </p>
                ))
              }
            </dd>
          </div>

          <div class="bg-white p-6 md:p-7">
            <dt class="flex items-center gap-2 text-[0.75rem] font-extrabold uppercase tracking-wider text-ink-muted">
              <Icon name="users" size={15} class="text-secondary-500" />Kuota & Kelas
            </dt>
            <dd class="mt-3 text-[0.9375rem] font-semibold leading-relaxed text-primary-800">
              {unit.quota}
            </dd>
          </div>

          <div class="bg-white p-6 md:p-7">
            <dt class="flex items-center gap-2 text-[0.75rem] font-extrabold uppercase tracking-wider text-ink-muted">
              <Icon name="map-pin" size={15} class="text-secondary-500" />Lokasi Kampus
            </dt>
            <dd class="mt-3 text-[0.875rem] leading-relaxed text-ink-soft">
              <span class="font-bold text-primary-800">{campus.name.split('—')[0].trim()}</span><br />
              {campus.address}
            </dd>
          </div>
        </dl>
      </Reveal>
    </div>
  </section>

  <!-- =========================================== PROGRAM UNGGULAN -->
  <section class="section relative overflow-hidden" aria-labelledby="program">
    <Ornament type="blob" class="pointer-events-none absolute -left-52 top-32 h-[34rem] w-[34rem] text-primary-50" />

    <div class="container relative">
      <SectionHeading
        eyebrow="Program Unggulan"
        title={`Yang membedakan ${unit.name}`}
        highlight={unit.name}
        desc={`Program di ${unit.code} dirancang mengikuti tahap perkembangan anak — bukan versi mengecil dari jenjang di atasnya.`}
        align="center"
        maxW="max-w-2xl"
      />

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          unit.programs.map((p, i) => (
            <Reveal delay={(i % 3) * 90} class="h-full">
              <FeatureCard icon={p.icon as any} title={p.title} desc={p.desc} class="h-full" />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ====================================== KURIKULUM & FASILITAS -->
  <section class="section relative bg-sand-100" aria-labelledby="kurikulum">
    <Ornament type="pattern" class="text-primary-600" opacity={0.03} />

    <div class="container relative">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
        <Reveal animation="left">
          <div class="h-full rounded-4xl border border-sand-200 bg-white p-8 shadow-soft md:p-10">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-600 text-white">
              <Icon name="book-open" size={23} />
            </span>
            <h2 class="mt-6 text-display-sm text-primary-800">Kurikulum & metode</h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">
              Perpaduan kurikulum nasional dengan pendekatan yang sudah teruji di kelas.
            </p>
            <ul class="mt-7 space-y-3.5">
              {
                unit.curriculum.map((c) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-50 text-primary-600">
                      <Icon name="check" size={13} strokeWidth={2.5} />
                    </span>
                    <span class="text-[0.9375rem] leading-relaxed text-ink-soft">{c}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </Reveal>

        <Reveal animation="right" delay={100}>
          <div class="h-full rounded-4xl border border-sand-200 bg-white p-8 shadow-soft md:p-10">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gold-400 text-primary-900">
              <Icon name="building" size={23} />
            </span>
            <h2 class="mt-6 text-display-sm text-primary-800">Fasilitas</h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">
              Semua yang dibutuhkan anak untuk belajar, bergerak, dan beribadah dengan nyaman.
            </p>
            <ul class="mt-7 grid gap-3 sm:grid-cols-2">
              {
                unit.facilities.map((f) => (
                  <li class="flex items-start gap-2.5 rounded-xl bg-sand-50 px-4 py-3">
                    <Icon name="check" size={15} class="mt-0.5 shrink-0 text-gold-600" strokeWidth={2.5} />
                    <span class="text-[0.875rem] font-semibold leading-snug text-ink-soft">{f}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </Reveal>
      </div>

      {
        unit.extracurricular.length > 0 && (
          <Reveal delay={120}>
            <div class="mt-10 rounded-4xl border border-sand-200 bg-white p-8 shadow-soft md:p-10">
              <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-secondary-500 text-white">
                  <Icon name="trophy" size={21} />
                </span>
                <h2 class="text-display-sm text-primary-800">Ekstrakurikuler</h2>
              </div>
              <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-ink-soft">
                Setiap siswa memilih minimal satu ekstrakurikuler agar punya ruang menemukan bakatnya
                di luar pelajaran kelas.
              </p>
              <ul class="mt-7 flex flex-wrap gap-2.5">
                {unit.extracurricular.map((e) => (
                  <li class="rounded-full border border-sand-200 bg-sand-50 px-5 py-2.5 text-[0.875rem] font-semibold text-ink-soft transition-all duration-300 ease-out-expo hover:-translate-y-0.5 hover:border-secondary-300 hover:bg-secondary-500 hover:text-white">
                    {e}
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        )
      }
    </div>
  </section>

  <!-- ========================================================= GALERI -->
  <section class="section" aria-labelledby="galeri">
    <div class="container">
      <SectionHeading
        eyebrow="Galeri"
        title={`Suasana keseharian di ${unit.name}`}
        highlight="keseharian"
        align="center"
        maxW="max-w-2xl"
      />
      <GalleryGrid items={galleryItems} layout="even" class="mt-14" />
    </div>
  </section>

  <!-- ======================================================= TESTIMONI -->
  <!-- Menempati pita gelap yang sebelumnya berisi tabel biaya, supaya irama
       terang–gelap halaman tetap terjaga setelah informasi biaya dihapus. -->
  <section class="section relative overflow-hidden bg-primary-900" aria-labelledby="testimoni">
    <Ornament type="star-grid" class="text-gold-300" opacity={0.05} />
    <Ornament type="wave-top" class="h-10 text-sand-50 md:h-16" />

    <div class="container relative pt-10">
      <SectionHeading
        eyebrow="Kata Wali Murid"
        title={`Pengalaman orang tua siswa ${unit.name}`}
        highlight="Pengalaman orang tua"
        align="center"
        tone="dark"
        maxW="max-w-2xl"
      />

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          quotes.map((t, i) => (
            <Reveal delay={(i % 3) * 90} class="h-full">
              <TestimonialCard item={t} tone="dark" class="h-full" />
            </Reveal>
          ))
        }
      </div>

      <Reveal delay={160}>
        <div class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href="/ppdb" variant="gold" icon="arrow-right">Alur Pendaftaran</Button>
          <Button
            href={waLink(unit.wa.number, waMsg)}
            variant="outline"
            icon="whatsapp"
            iconPosition="left"
            external
            class="!border-white/25 !bg-white/5 !text-white hover:!border-white/60 hover:!bg-white/10"
          >
            Tanya Admin {unit.code}
          </Button>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ============================================================ FAQ -->
  <section class="section bg-sand-100" aria-labelledby="faq">
    <div class="container">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeading
            eyebrow="Pertanyaan Umum"
            title={`Hal yang sering ditanyakan tentang ${unit.code}`}
            highlight="sering ditanyakan"
            desc="Belum terjawab? Tanyakan langsung ke admin unit lewat WhatsApp, biasanya dibalas di hari yang sama."
            maxW="max-w-none"
          />
          <Reveal delay={200}>
            <div class="mt-8">
              <Button href={waLink(unit.wa.number, waMsg)} variant="primary" icon="whatsapp" iconPosition="left" external>
                Tanya Admin {unit.code}
              </Button>
            </div>
          </Reveal>
        </div>
        <div class="lg:col-span-7">
          <Accordion items={unit.faq} />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================== UNIT LAINNYA -->
  <section class="section" aria-labelledby="unit-lain">
    <div class="container">
      <SectionHeading eyebrow="Unit Lainnya" title="Jelajahi unit lain di Panatagama" highlight="unit lain" />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((u, i) => <Reveal delay={i * 90}><UnitCard unit={u} class="h-full" /></Reveal>)}
      </div>
    </div>
  </section>

  <CtaBand
    title={`Amankan kursi ananda di ${unit.name}`}
    waNumber={unit.wa.number}
    waMessage={waMsg}
  />
</BaseLayout>
